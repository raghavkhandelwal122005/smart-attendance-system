# ==============================================================================
# Smart Attendance System - Environment Variables Configuration
# ==============================================================================

# Server Network Binds
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Set your Vercel frontend URL in production)
# Example: ALLOWED_ORIGINS=https://smart-attendance-system.vercel.app,http://localhost:8000
ALLOWED_ORIGINS=*

# AI Face Engine & Model Settings
DEFAULT_THRESHOLD=0.35
INSIGHTFACE_HOME=/tmp/.insightface

# Database & Storage Paths
# For persistent volume on Render/Railway, set: DB_PATH=/data/attendance.db
DB_PATH=backend/data/attendance.db

# Frontend API Endpoint (Used if hosting frontend separately on Vercel)
# Example: VITE_API_URL=https://your-backend-app.onrender.com
API_URL=http://localhost:8000
