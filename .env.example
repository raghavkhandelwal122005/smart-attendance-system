# ==============================================================================
# Smart Attendance System — Environment Variables
# Copy this file to .env and fill in your values for local development.
# In production (Vercel), set these in the Vercel dashboard → Project → Settings → Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — PostgreSQL database
# ------------------------------------------------------------------------------
# Vercel Postgres, Neon, Supabase, Render, or Railway all work.
# Vercel Postgres auto-populates this as POSTGRES_URL; the app reads both.
#
# Example:
#   DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — InsightFace model cache directory
# On Vercel the home directory is read-only; models must download to /tmp.
# Set this in Vercel dashboard exactly as shown.
# ------------------------------------------------------------------------------
INSIGHTFACE_HOME=/tmp/.insightface

# ------------------------------------------------------------------------------
# RECOMMENDED IN PRODUCTION — Persistent photo storage
# Without one of these, student/session photos are stored in /tmp and are
# lost on every cold start (the AI recognition still works because embeddings
# are in PostgreSQL, but photos won't be viewable between requests).
# ------------------------------------------------------------------------------

# Option A: Cloudinary  (https://cloudinary.com — free tier available)
#   Set the full CLOUDINARY_URL string from your Cloudinary dashboard.
#   Example: cloudinary://API_KEY:API_SECRET@YOUR_CLOUD_NAME
CLOUDINARY_URL=

# Option B: Vercel Blob  (https://vercel.com/docs/storage/vercel-blob)
#   Create a Blob store in your Vercel project; the token is auto-generated.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# OPTIONAL — CORS origins
# Comma-separated list of allowed origins. '*' allows all (fine for demos).
# For production: ALLOWED_ORIGINS=https://your-app.vercel.app
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY — not used in production
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
